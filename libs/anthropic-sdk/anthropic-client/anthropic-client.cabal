cabal-version:   3.0
name:            anthropic-client
version:         0.1.0.0
synopsis:        Haskell client SDK for the Anthropic Messages API
description:
  Client SDK for the Anthropic Messages API. Provides client lifecycle
  management, message creation, streaming, token counting, model queries,
  batch operations, retry logic, and rate limit observability.

license:         BSD-3-Clause
license-file:    LICENSE
author:          Anthropic API Haskell Contributors
maintainer:      noreply@example.com
category:        Web
build-type:      Simple

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints

library
  import:           warnings
  default-language: Haskell2010
  default-extensions:
    DerivingStrategies
    DeriveGeneric
    GeneralizedNewtypeDeriving
    OverloadedStrings
    StrictData
    DuplicateRecordFields
    NoFieldSelectors
    OverloadedRecordDot
    LambdaCase

  hs-source-dirs:   src

  exposed-modules:
    Anthropic.Client
    Anthropic.Client.Config
    Anthropic.Client.Messages
    Anthropic.Client.Streaming
    Anthropic.Client.Models
    Anthropic.Client.Batches
    Anthropic.Client.Internal.Http
    Anthropic.Client.Internal.Retry
    Anthropic.Client.Internal.RateLimit
    Anthropic.Client.Internal.SSE
    Anthropic.Client.Internal.Execute

  build-depends:
    , base              >= 4.18 && < 5
    , text              >= 2.0
    , aeson             >= 2.1
    , bytestring        >= 0.11
    , containers        >= 0.6
    , time              >= 1.12
    , http-client       >= 0.7
    , http-client-tls   >= 0.3
    , http-types        >= 0.12
    , retry             >= 0.9
    , stm               >= 2.5
    , streaming         >= 0.2
    , random            >= 1.2
    , case-insensitive  >= 1.2
    , exceptions        >= 0.10
    , anthropic-types
    , anthropic-protocol
    , otel-api

executable ergonomics-check
  import:           warnings
  default-language: Haskell2010
  default-extensions:
    OverloadedStrings
    DuplicateRecordFields
  hs-source-dirs:   ergonomics
  main-is:          Main.hs
  build-depends:
    , base              >= 4.18 && < 5
    , text              >= 2.0
    , aeson             >= 2.1
    , json-schema-combinators
    , anthropic-types
    , anthropic-protocol
    , anthropic-client

test-suite anthropic-client-test
  import:           warnings
  type:             exitcode-stdio-1.0
  default-language: Haskell2010
  default-extensions:
    DerivingStrategies
    DeriveGeneric
    GeneralizedNewtypeDeriving
    OverloadedStrings
    StrictData
    DuplicateRecordFields
    NoFieldSelectors
    OverloadedRecordDot
    LambdaCase

  hs-source-dirs:   test
  main-is:          Spec.hs

  other-modules:
    Anthropic.Client.Internal.HttpSpec
    Anthropic.Client.Internal.RateLimitSpec
    Anthropic.Client.Internal.RetrySpec
    Anthropic.Client.ConfigSpec
    Anthropic.Client.StreamingSpec

  build-depends:
    , base              >= 4.18 && < 5
    , text              >= 2.0
    , aeson             >= 2.1
    , bytestring        >= 0.11
    , http-client       >= 0.7
    , http-types        >= 0.12
    , stm               >= 2.5
    , streaming         >= 0.2
    , time              >= 1.12
    , case-insensitive  >= 1.2
    , hspec             >= 2.11
    , hspec-discover    >= 2.11
    , QuickCheck        >= 2.14
    , anthropic-types
    , anthropic-protocol
    , anthropic-client

  build-tool-depends:
    hspec-discover:hspec-discover >= 2.11
