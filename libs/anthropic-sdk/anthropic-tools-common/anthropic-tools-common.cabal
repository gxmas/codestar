cabal-version:   3.0
name:            anthropic-tools-common
version:         0.1.0.0
synopsis:        Pre-built tool definitions for the Anthropic Messages API
description:
  Reusable tool definitions for common operations (file system, shell,
  network) with typed JSON schemas and optional execution adapters.
  Framework-agnostic composable building blocks.

license:         BSD-3-Clause
license-file:    LICENSE
author:          Anthropic API Haskell Contributors
maintainer:      noreply@example.com
category:        Web
build-type:      Simple

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints

library
  import:           warnings
  default-language: Haskell2010
  default-extensions:
    DerivingStrategies
    DeriveGeneric
    GeneralizedNewtypeDeriving
    OverloadedStrings
    StrictData
    DuplicateRecordFields
    NoFieldSelectors
    OverloadedRecordDot
    LambdaCase

  hs-source-dirs:   src

  exposed-modules:
    Anthropic.Tools.Common
    Anthropic.Tools.Common.Schema
    Anthropic.Tools.Common.FileSystem
    Anthropic.Tools.Common.Shell
    Anthropic.Tools.Common.Network
    Anthropic.Tools.Common.Parser
    Anthropic.Tools.Common.Executor

  build-depends:
    , base                      >= 4.18 && < 5
    , text                      >= 2.0
    , aeson                     >= 2.1
    , bytestring                >= 0.11
    , containers                >= 0.6
    , directory                 >= 1.3
    , filepath                  >= 1.4
    , process                   >= 1.6
    , http-client               >= 0.7
    , http-client-tls           >= 0.3
    , case-insensitive          >= 1.2
    , json-schema-combinators
    , anthropic-types
    , anthropic-protocol

test-suite anthropic-tools-common-test
  import:           warnings
  type:             exitcode-stdio-1.0
  default-language: Haskell2010
  default-extensions:
    DerivingStrategies
    DeriveGeneric
    GeneralizedNewtypeDeriving
    OverloadedStrings
    StrictData
    DuplicateRecordFields
    NoFieldSelectors
    OverloadedRecordDot
    LambdaCase
    ScopedTypeVariables

  hs-source-dirs:   test
  main-is:          Spec.hs

  other-modules:
    Anthropic.Tools.Common.SchemaSpec
    Anthropic.Tools.Common.ParserSpec
    Anthropic.Tools.Common.ExecutorSpec

  build-depends:
    , base                      >= 4.18 && < 5
    , text                      >= 2.0
    , aeson                     >= 2.1
    , bytestring                >= 0.11
    , containers                >= 0.6
    , directory                 >= 1.3
    , filepath                  >= 1.4
    , temporary                 >= 1.3
    , hspec                     >= 2.11
    , hspec-discover            >= 2.11
    , QuickCheck                >= 2.14
    , anthropic-types
    , anthropic-protocol
    , vector                    >= 0.13
    , json-schema-combinators
    , anthropic-tools-common

  build-tool-depends:
    hspec-discover:hspec-discover >= 2.11
