cabal-version:   3.0
name:            anthropic-types
version:         0.1.0.0
synopsis:        Shared types for the Anthropic Messages API
description:
  Pure type definitions for the Anthropic Messages API.
  Content blocks, error types, usage, pagination, and all
  shared vocabulary used by anthropic-protocol, anthropic-client,
  and anthropic-server.

license:         BSD-3-Clause
license-file:    LICENSE
author:          Anthropic API Haskell Contributors
maintainer:      noreply@example.com
category:        Web
build-type:      Simple

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints

library
  import:           warnings
  default-language: Haskell2010
  default-extensions:
    DerivingStrategies
    DeriveGeneric
    GeneralizedNewtypeDeriving
    OverloadedStrings
    StrictData
    DuplicateRecordFields
    NoFieldSelectors
    OverloadedRecordDot
    LambdaCase

  hs-source-dirs:   src

  exposed-modules:
    Anthropic.Types
    Anthropic.Types.Core
    Anthropic.Types.Error
    Anthropic.Types.Cache
    Anthropic.Types.Usage
    Anthropic.Types.Pagination
    Anthropic.Types.Content
    Anthropic.Types.Content.Text
    Anthropic.Types.Content.Image
    Anthropic.Types.Content.Document
    Anthropic.Types.Content.ToolUse
    Anthropic.Types.Content.ToolResult
    Anthropic.Types.Content.Thinking
    Anthropic.Types.Content.Search

  build-depends:
    , base        >= 4.18 && < 5
    , text        >= 2.0
    , aeson       >= 2.1
    , bytestring  >= 0.11
    , containers  >= 0.6
    , time        >= 1.12
    , scientific  >= 0.3

test-suite anthropic-types-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  other-modules:
    Anthropic.Types.CoreSpec
    Anthropic.Types.ErrorSpec
    Anthropic.Types.CacheSpec
    Anthropic.Types.UsageSpec
    Anthropic.Types.PaginationSpec
    Anthropic.Types.ContentSpec
    Anthropic.Types.Generators
  default-language: Haskell2010
  default-extensions:
    OverloadedStrings
    OverloadedRecordDot
    NoFieldSelectors
    DuplicateRecordFields
    LambdaCase
    ScopedTypeVariables
  ghc-options:      -threaded
  build-tool-depends: hspec-discover:hspec-discover
  build-depends:
    , base             >= 4.18 && < 5
    , anthropic-types
    , aeson
    , bytestring
    , text
    , hspec
    , QuickCheck
