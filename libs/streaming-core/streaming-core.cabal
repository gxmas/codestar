cabal-version:      3.0
name:               streaming-core
version:            0.1.0.0
synopsis:           Backpressure-aware streaming primitives
description:        Bounded streams backed by STM TBQueue with natural
                    backpressure, pause/resume, merge, and split combinators.
license:            MIT
author:             Geoffrey Noël
maintainer:         noel.geoff@gmail.com
category:           Streaming
build-type:         Simple

common shared-properties
    default-language: GHC2021
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints
        -Wunused-packages
    default-extensions:
        DerivingStrategies
        DuplicateRecordFields
        LambdaCase
        OverloadedRecordDot
        OverloadedStrings

library
    import:           shared-properties
    hs-source-dirs:   src
    exposed-modules:
        Streaming.Core
    build-depends:
        base >=4.18 && <5,
        telemetry-core,
        async >=2.2,
        stm >=2.5,
        text >=2.0,
        uuid >=1.3

test-suite streaming-core-test
    import:           shared-properties
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    build-depends:
        base >=4.18 && <5,
        streaming-core,
        hedgehog >=1.4,
        tasty >=1.4,
        tasty-hedgehog >=1.4
    ghc-options:
        -threaded
        -rtsopts
        -with-rtsopts=-N
