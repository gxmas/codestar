cabal-version: 3.0
name:          ollama-sdk
version:       0.1.0.0
synopsis:      Ollama local LLM client
description:
  Client for the Ollama local model server. Ollama implements the
  OpenAI-compatible API at http://localhost:11434, so this library
  is a thin wrapper over openai-sdk with Ollama-specific defaults
  and the native /api/tags model listing endpoint.
license:       NONE
build-type:    Simple

common shared
  default-language: GHC2021
  default-extensions:
    OverloadedStrings
    DerivingStrategies
    DeriveAnyClass
    DeriveGeneric
    DuplicateRecordFields
    OverloadedRecordDot
    StrictData
    LambdaCase
  ghc-options: -Wall -Wunused-packages

library
  import:         shared
  hs-source-dirs: src
  exposed-modules:
    Ollama
    Ollama.Client
    Ollama.Types
  build-depends:
      base        >= 4.18 && < 5
    , aeson       >= 2.1
    , openai-sdk
    , text        >= 2.0
