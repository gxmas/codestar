cabal-version:      3.0
name:               resilience
version:            0.1.0.0
synopsis:           Retry, exponential backoff, and circuit breaker
description:        Error recovery with configurable retry policies and
                    per-operation circuit breakers.
license:            MIT
author:             Geoffrey Noël
maintainer:         noel.geoff@gmail.com
category:           Control
build-type:         Simple

common shared-properties
    default-language: GHC2021
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints
        -Wunused-packages
    default-extensions:
        DerivingStrategies
        DuplicateRecordFields
        LambdaCase
        OverloadedRecordDot
        OverloadedStrings

library
    import:           shared-properties
    hs-source-dirs:   src
    exposed-modules:
        Resilience.Core
    build-depends:
        base >=4.18 && <5,
        telemetry-core,
        aeson >=2.1,
        async >=2.2,
        containers >=0.6,
        random >=1.2,
        stm >=2.5,
        text >=2.0,
        time >=1.12

test-suite resilience-test
    import:           shared-properties
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    build-depends:
        base >=4.18 && <5,
        resilience,
        hedgehog >=1.4,
        tasty >=1.4,
        tasty-hedgehog >=1.4
    ghc-options:
        -threaded
        -rtsopts
        -with-rtsopts=-N
