cabal-version:      3.0
name:               telemetry-core
version:            0.1.0.0
synopsis:           Telemetry abstraction — tracing, logging, metrics
description:        Primitive telemetry interface covering all three observability
                    signals. Own types throughout — no hs-opentelemetry types in the
                    public surface. No-op implementation for testing. Production
                    backend wraps hs-opentelemetry-api.
license:            MIT
author:             Geoffrey Noël
maintainer:         noel.geoff@gmail.com
category:           Observability
build-type:         Simple

common shared-properties
    default-language: GHC2021
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints
        -Wunused-packages
    default-extensions:
        DerivingStrategies
        DuplicateRecordFields
        LambdaCase
        OverloadedRecordDot
        OverloadedStrings
        RankNTypes

library
    import:           shared-properties
    hs-source-dirs:   src
    exposed-modules:
        Telemetry.Core
    other-modules:
        Telemetry.Core.Types
        Telemetry.Core.Internal.Backend
        Telemetry.Core.Internal.Global
        Telemetry.Core.Internal.MetricsServer
        Telemetry.Core.Internal.NoOp
        Telemetry.Core.Internal.OpenTelemetry
    build-depends:
        base >=4.18 && <5,
        aeson >=2.1,
        async >=2.2,
        bytestring >=0.11,
        containers >=0.6,
        hs-opentelemetry-api >=0.3 && <0.4,
        hs-opentelemetry-exporter-otlp >=0.1 && <0.2,
        hs-opentelemetry-sdk >=0.1 && <0.2,
        http-types >=0.12,
        prometheus-client >=1.1 && <1.2,
        unordered-containers >=0.2,
        text >=2.0,
        time >=1.12,
        wai >=3.2,
        warp >=3.3

test-suite telemetry-core-test
    import:           shared-properties
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    build-depends:
        base >=4.18 && <5,
        telemetry-core,
        hedgehog >=1.4,
        tasty >=1.4,
        tasty-hedgehog >=1.4
    ghc-options:
        -threaded
        -rtsopts
        -with-rtsopts=-N
