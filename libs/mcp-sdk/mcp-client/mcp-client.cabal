cabal-version: 3.0
name:          mcp-client
version:       0.1.0.0
synopsis:      Client feature layer for the Model Context Protocol
license:       MIT
author:        Geoffrey Noel
maintainer:    noel.geoff@gmail.com
category:      Network
build-type:    Simple

common warnings
  ghc-options:
    -Wall -Wcompat -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wredundant-constraints

common extensions
  default-language:   GHC2021
  default-extensions:
    DeriveGeneric
    DerivingStrategies
    LambdaCase
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings
    StrictData

library
  import:         warnings, extensions
  hs-source-dirs: src
  exposed-modules:
    Network.MCP.Client.Elicitation
    Network.MCP.Client.Resources
    Network.MCP.Client.Roots
    Network.MCP.Client.Sampling
    Network.MCP.Client.Tools

  build-depends:
    , aeson                >= 2.1
    , base                 >= 4.16 && < 5
    , bytestring           >= 0.11
    , mcp-core
    , mcp-session
    , stm                  >= 2.5
    , text                 >= 2.0
    , unordered-containers >= 0.2

test-suite mcp-client-test
  import:         warnings, extensions
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Spec.hs
  other-modules:
    Network.MCP.Client.ToolsSpec
  build-depends:
    , aeson                >= 2.1
    , base                 >= 4.16 && < 5
    , hspec                >= 2.9
    , mcp-client
    , mcp-core
    , mcp-session
    , QuickCheck           >= 2.14
    , stm                  >= 2.5
    , text                 >= 2.0
    , unordered-containers >= 0.2

  build-tool-depends: hspec-discover:hspec-discover >= 2.9
