cabal-version: 3.0
name:          otel-exporter-otlp-http
version:       0.1.0.0
synopsis:      OpenTelemetry OTLP exporter over HTTP
description:
  OTLP exporter that ships traces, metrics, and logs over HTTP/1.1 with
  protobuf or JSON encoding. Supports gzip compression, configurable
  endpoints, and custom headers. Implements the OTel OTLP/HTTP exporter
  specification.

license:       BSD-3-Clause
homepage:      https://github.com/noel-geoff/otel-haskell
bug-reports:   https://github.com/noel-geoff/otel-haskell/issues
author:        Geoffrey Noel <noel.geoff@gmail.com>
maintainer:    Geoffrey Noel <noel.geoff@gmail.com>
category:      Network
build-type:    Simple
extra-doc-files: CHANGELOG.md

source-repository head
  type:     git
  location: https://github.com/noel-geoff/otel-haskell

library
  hs-source-dirs: src
  default-language: GHC2021
  default-extensions:
    StrictData
    OverloadedStrings
    OverloadedRecordDot
    DuplicateRecordFields
    DerivingStrategies
    GADTs
    DataKinds
    KindSignatures
    TypeFamilies
  ghc-options: -Wall
  build-depends:
    base >= 4.18 && < 4.22,
    text >= 2.1 && < 2.2,
    bytestring >= 0.12 && < 0.13,
    stm >= 2.5 && < 2.6,
    http-client >= 0.7 && < 0.8,
    http-client-tls >= 0.4 && < 0.5,
    aeson >= 2.2 && < 2.3,
    zlib >= 0.7 && < 0.8,
    proto-lens-runtime >= 0.7 && < 0.8,
    otel-proto >= 0.1 && < 0.2,
    otel-api >= 0.1 && < 0.2,
    otel-sdk-common >= 0.1 && < 0.2,
    otel-sdk-traces >= 0.1 && < 0.2,
    otel-sdk-metrics >= 0.1 && < 0.2,
    otel-sdk-logs >= 0.1 && < 0.2,
    containers >= 0.7 && < 0.8,
    proto-lens >= 0.7 && < 0.8,
    case-insensitive >= 1.2 && < 1.3,
    http-types >= 0.12 && < 0.13,
    otel-exporter-otlp-grpc >= 0.1 && < 0.2,
    vector >= 0.13 && < 0.14,
    base64-bytestring >= 1.2 && < 1.3,
    lens-family >= 2.1 && < 2.2
  exposed-modules:
    OTel.Exporter.OTLP.HTTP

test-suite otel-exporter-otlp-http-test
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  default-language: GHC2021
  default-extensions:
    StrictData
    OverloadedStrings
    OverloadedRecordDot
    DuplicateRecordFields
    DerivingStrategies
    GADTs
    DataKinds
    KindSignatures
    TypeFamilies
  ghc-options: -Wall
  build-depends:
    otel-exporter-otlp-http,
    base >= 4.18 && < 4.22,
    aeson >= 2.2 && < 2.3,
    async >= 2.2 && < 2.3,
    bytestring >= 0.12 && < 0.13,
    containers >= 0.7 && < 0.8,
    http-client >= 0.7 && < 0.8,
    http-client-tls >= 0.4 && < 0.5,
    http-types >= 0.12 && < 0.13,
    lens-family >= 2.1 && < 2.2,
    network >= 3.2 && < 3.3,
    proto-lens >= 0.7 && < 0.8,
    proto-lens-runtime >= 0.7 && < 0.8,
    stm >= 2.5 && < 2.6,
    text >= 2.1 && < 2.2,
    otel-api >= 0.1 && < 0.2,
    otel-exporter-otlp-grpc >= 0.1 && < 0.2,
    otel-proto >= 0.1 && < 0.2,
    otel-sdk-common >= 0.1 && < 0.2,
    otel-sdk-traces >= 0.1 && < 0.2,
    otel-sdk-metrics >= 0.1 && < 0.2,
    otel-sdk-logs >= 0.1 && < 0.2,
    tasty >= 1.5 && < 1.6,
    tasty-hunit >= 0.10 && < 0.11
