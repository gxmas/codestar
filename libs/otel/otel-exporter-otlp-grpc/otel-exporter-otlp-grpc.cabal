cabal-version: 3.0
name:          otel-exporter-otlp-grpc
version:       0.1.0.0
synopsis:      OpenTelemetry OTLP exporter over gRPC
description:
  OTLP exporter that ships traces, metrics, and logs over gRPC using HTTP/2
  framing with protobuf encoding, retry logic, and optional TLS. Implements
  the OTel OTLP/gRPC exporter specification.

license:       BSD-3-Clause
homepage:      https://github.com/noel-geoff/otel-haskell
bug-reports:   https://github.com/noel-geoff/otel-haskell/issues
author:        Geoffrey Noel <noel.geoff@gmail.com>
maintainer:    Geoffrey Noel <noel.geoff@gmail.com>
category:      Network
build-type:    Simple
extra-doc-files: CHANGELOG.md

source-repository head
  type:     git
  location: https://github.com/noel-geoff/otel-haskell

library
  hs-source-dirs: src
  default-language: GHC2021
  default-extensions:
    StrictData
    OverloadedStrings
    OverloadedRecordDot
    DuplicateRecordFields
    DerivingStrategies
    GADTs
    DataKinds
    KindSignatures
    TypeFamilies
  ghc-options: -Wall
  build-depends:
    base >= 4.18 && < 4.22,
    text >= 2.1 && < 2.2,
    bytestring >= 0.12 && < 0.13,
    containers >= 0.7 && < 0.8,
    stm >= 2.5 && < 2.6,
    http2 >= 5.4 && < 5.5,
    http-semantics >= 0.4 && < 0.5,
    http-types >= 0.12 && < 0.13,
    case-insensitive >= 1.2 && < 1.3,
    tls >= 2.4 && < 2.5,
    crypton-x509-system >= 1.9 && < 1.10,
    crypton-x509-store >= 1.9 && < 1.10,
    zlib >= 0.7 && < 0.8,
    network >= 3.2 && < 3.3,
    random >= 1.3 && < 1.4,
    lens-family >= 2.1 && < 2.2,
    vector >= 0.13 && < 0.14,
    proto-lens >= 0.7 && < 0.8,
    proto-lens-runtime >= 0.7 && < 0.8,
    otel-proto >= 0.1 && < 0.2,
    otel-api >= 0.1 && < 0.2,
    otel-sdk-common >= 0.1 && < 0.2,
    otel-sdk-traces >= 0.1 && < 0.2,
    otel-sdk-metrics >= 0.1 && < 0.2,
    otel-sdk-logs >= 0.1 && < 0.2
  exposed-modules:
    OTel.Exporter.OTLP.GRPC
    OTel.Exporter.OTLP.GRPC.Internal
    OTel.Exporter.OTLP.GRPC.Internal.Proto
  other-modules:
    OTel.Exporter.OTLP.GRPC.Internal.Status
    OTel.Exporter.OTLP.GRPC.Internal.Frame
    OTel.Exporter.OTLP.GRPC.Internal.Retry
    OTel.Exporter.OTLP.GRPC.Internal.Client

test-suite otel-exporter-otlp-grpc-test
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  default-language: GHC2021
  default-extensions:
    StrictData
    OverloadedStrings
    OverloadedRecordDot
    DuplicateRecordFields
    DerivingStrategies
    GADTs
    DataKinds
    KindSignatures
    TypeFamilies
  ghc-options: -Wall -threaded
  build-depends:
    otel-exporter-otlp-grpc,
    base >= 4.18 && < 4.22,
    text >= 2.1 && < 2.2,
    bytestring >= 0.12 && < 0.13,
    containers >= 0.7 && < 0.8,
    stm >= 2.5 && < 2.6,
    async >= 2.2 && < 2.3,
    http2 >= 5.4 && < 5.5,
    http-semantics >= 0.4 && < 0.5,
    http-types >= 0.12 && < 0.13,
    case-insensitive >= 1.2 && < 1.3,
    tls >= 2.4 && < 2.5,
    zlib >= 0.7 && < 0.8,
    network >= 3.2 && < 3.3,
    random >= 1.3 && < 1.4,
    lens-family >= 2.1 && < 2.2,
    vector >= 0.13 && < 0.14,
    tasty >= 1.5 && < 1.6,
    tasty-quickcheck >= 0.11 && < 0.12,
    tasty-hunit >= 0.10 && < 0.11,
    proto-lens >= 0.7 && < 0.8,
    otel-proto >= 0.1 && < 0.2,
    otel-api >= 0.1 && < 0.2,
    otel-sdk-common >= 0.1 && < 0.2,
    otel-sdk-traces >= 0.1 && < 0.2,
    otel-sdk-metrics >= 0.1 && < 0.2,
    otel-sdk-logs >= 0.1 && < 0.2
