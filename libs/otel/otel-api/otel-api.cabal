cabal-version: 3.0
name:          otel-api
version:       0.1.0.0
synopsis:      OpenTelemetry API for Haskell
description:
  A spec-compliant OpenTelemetry API for Haskell providing trace, metric,
  log, and experimental profiling signal types, context propagation, and the W3C
  TraceContext / Baggage propagators.

license:       BSD-3-Clause
homepage:      https://github.com/noel-geoff/otel-haskell
bug-reports:   https://github.com/noel-geoff/otel-haskell/issues
author:        Geoffrey Noel <noel.geoff@gmail.com>
maintainer:    Geoffrey Noel <noel.geoff@gmail.com>
category:      Network
build-type:    Simple
extra-doc-files: CHANGELOG.md

source-repository head
  type:     git
  location: https://github.com/noel-geoff/otel-haskell

library
  hs-source-dirs: src
  default-language: GHC2021
  default-extensions:
    StrictData
    OverloadedStrings
    OverloadedRecordDot
    DuplicateRecordFields
    DerivingStrategies
    GADTs
    DataKinds
    KindSignatures
    TypeFamilies
  ghc-options: -Wall
  build-depends:
    base >= 4.18 && < 4.22,
    text >= 2.1 && < 2.2,
    bytestring >= 0.12 && < 0.13,
    containers >= 0.7 && < 0.8,
    vector >= 0.13 && < 0.14,
    stm >= 2.5 && < 2.6,
    clock >= 0.8 && < 0.9
  exposed-modules:
    OTel.Context
    OTel.Context.Key
    OTel.Propagation
    OTel.Propagation.W3C
    OTel.Attribute
    OTel.Baggage
    OTel.Timestamp
    OTel.Trace
    OTel.Trace.SpanContext
    OTel.Trace.TraceState
    OTel.Metric
    OTel.Metric.Instrument
    OTel.Log
    OTel.Profile

test-suite otel-api-test
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  default-language: GHC2021
  default-extensions:
    StrictData
    OverloadedStrings
    OverloadedRecordDot
    DuplicateRecordFields
    DerivingStrategies
    GADTs
    DataKinds
    KindSignatures
    TypeFamilies
  ghc-options: -Wall
  build-depends:
    otel-api,
    base >= 4.18 && < 4.22,
    tasty >= 1.5 && < 1.6,
    tasty-quickcheck >= 0.11 && < 0.12,
    tasty-hunit >= 0.10 && < 0.11,
    QuickCheck >= 2.18 && < 2.19,
    text >= 2.1 && < 2.2,
    vector >= 0.13 && < 0.14,
    containers >= 0.7 && < 0.8,
    bytestring >= 0.12 && < 0.13
