cabal-version: 3.0
name:          otel-sdk-config
version:       0.1.0.0
synopsis:      OpenTelemetry SDK file-based configuration
description:
  File-based configuration for the OpenTelemetry Haskell SDK. Reads YAML
  configuration files following the OTel file configuration specification
  and wires up tracer providers, meter providers, and log providers
  accordingly.

license:       BSD-3-Clause
homepage:      https://github.com/noel-geoff/otel-haskell
bug-reports:   https://github.com/noel-geoff/otel-haskell/issues
author:        Geoffrey Noel <noel.geoff@gmail.com>
maintainer:    Geoffrey Noel <noel.geoff@gmail.com>
category:      Network
build-type:    Simple
extra-doc-files: CHANGELOG.md

source-repository head
  type:     git
  location: https://github.com/noel-geoff/otel-haskell

library
  hs-source-dirs: src
  default-language: GHC2021
  default-extensions:
    StrictData
    OverloadedStrings
    OverloadedRecordDot
    DuplicateRecordFields
    DerivingStrategies
    GADTs
    DataKinds
    KindSignatures
    TypeFamilies
  ghc-options: -Wall
  build-depends:
    base >= 4.18 && < 4.22,
    text >= 2.1 && < 2.2,
    bytestring >= 0.12 && < 0.13,
    containers >= 0.7 && < 0.8,
    aeson >= 2.2 && < 2.3,
    yaml >= 0.11 && < 0.12,
    otel-api >= 0.1 && < 0.2,
    otel-sdk-common >= 0.1 && < 0.2,
    otel-sdk-traces >= 0.1 && < 0.2,
    otel-sdk-metrics >= 0.1 && < 0.2,
    otel-sdk-logs >= 0.1 && < 0.2,
    otel-exporter-console >= 0.1 && < 0.2
  exposed-modules:
    OTel.SDK.Config

test-suite otel-sdk-config-test
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  default-language: GHC2021
  default-extensions:
    StrictData
    OverloadedStrings
    OverloadedRecordDot
    DuplicateRecordFields
    DerivingStrategies
    GADTs
    DataKinds
    KindSignatures
    TypeFamilies
  ghc-options: -Wall
  build-depends:
    otel-sdk-config,
    base >= 4.18 && < 4.22,
    tasty >= 1.5 && < 1.6,
    tasty-quickcheck >= 0.11 && < 0.12,
    tasty-hunit >= 0.10 && < 0.11,
    otel-api >= 0.1 && < 0.2,
    otel-sdk-common >= 0.1 && < 0.2,
    otel-sdk-traces >= 0.1 && < 0.2,
    otel-sdk-metrics >= 0.1 && < 0.2,
    otel-sdk-logs >= 0.1 && < 0.2,
    otel-exporter-console >= 0.1 && < 0.2,
    text >= 2.1 && < 2.2,
    bytestring >= 0.12 && < 0.13,
    stm >= 2.5 && < 2.6,
    directory
