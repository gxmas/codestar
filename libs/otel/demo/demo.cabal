cabal-version: 3.0
name:          demo
version:       0.1.0.0
synopsis:      Walking skeleton demo — trace pipeline end-to-end
license:       BSD-3-Clause
build-type:    Simple

executable demo
  main-is:            Main.hs
  hs-source-dirs:     src
  default-language:   GHC2021
  default-extensions:
    StrictData
    OverloadedStrings
    OverloadedRecordDot
    DuplicateRecordFields
    DerivingStrategies
  ghc-options: -Wall -Werror
  build-depends:
    base >=4.18 && <5,
    text,
    vector,
    stm,
    async,
    containers,
    otel-api,
    otel-sdk-common,
    otel-sdk-traces,
    otel-sdk-metrics,
    otel-sdk-logs,
    otel-sdk-config,
    otel-semconv,
    otel-exporter-console,
    otel-exporter-inmemory
