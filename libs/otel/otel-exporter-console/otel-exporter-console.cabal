cabal-version: 3.0
name:          otel-exporter-console
version:       0.1.0.0
synopsis:      OpenTelemetry console exporter for debugging
description:
  Console exporter for the OpenTelemetry Haskell SDK that prints spans,
  metrics, and log records to stdout in a human-readable format. Useful
  for local development and debugging.

license:       BSD-3-Clause
homepage:      https://github.com/noel-geoff/otel-haskell
bug-reports:   https://github.com/noel-geoff/otel-haskell/issues
author:        Geoffrey Noel <noel.geoff@gmail.com>
maintainer:    Geoffrey Noel <noel.geoff@gmail.com>
category:      Network
build-type:    Simple
extra-doc-files: CHANGELOG.md

source-repository head
  type:     git
  location: https://github.com/noel-geoff/otel-haskell

library
  hs-source-dirs: src
  default-language: GHC2021
  default-extensions:
    StrictData
    OverloadedStrings
    OverloadedRecordDot
    DuplicateRecordFields
    DerivingStrategies
    GADTs
    DataKinds
    KindSignatures
    TypeFamilies
  ghc-options: -Wall
  build-depends:
    base >= 4.18 && < 4.22,
    text >= 2.1 && < 2.2,
    vector >= 0.13 && < 0.14,
    containers >= 0.7 && < 0.8,
    otel-api >= 0.1 && < 0.2,
    otel-sdk-common >= 0.1 && < 0.2,
    otel-sdk-traces >= 0.1 && < 0.2,
    otel-sdk-metrics >= 0.1 && < 0.2,
    otel-sdk-logs >= 0.1 && < 0.2
  exposed-modules:
    OTel.Exporter.Console

test-suite otel-exporter-console-test
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  default-language: GHC2021
  default-extensions:
    StrictData
    OverloadedStrings
    OverloadedRecordDot
    DuplicateRecordFields
    DerivingStrategies
    GADTs
    DataKinds
    KindSignatures
    TypeFamilies
  ghc-options: -Wall
  build-depends:
    otel-exporter-console,
    otel-api >= 0.1 && < 0.2,
    otel-sdk-common >= 0.1 && < 0.2,
    otel-sdk-traces >= 0.1 && < 0.2,
    otel-sdk-metrics >= 0.1 && < 0.2,
    otel-sdk-logs >= 0.1 && < 0.2,
    base >= 4.18 && < 4.22,
    tasty >= 1.5 && < 1.6,
    tasty-hunit >= 0.10 && < 0.11,
    text >= 2.1 && < 2.2,
    directory
