cabal-version: 3.0
name:          otel-sdk-traces
version:       0.1.0.0
synopsis:      OpenTelemetry SDK tracing
description:
  OpenTelemetry SDK trace implementation providing configurable samplers,
  span processors (simple and batch), and an export pipeline compliant with
  the OTel Trace SDK specification.

license:       BSD-3-Clause
homepage:      https://github.com/noel-geoff/otel-haskell
bug-reports:   https://github.com/noel-geoff/otel-haskell/issues
author:        Geoffrey Noel <noel.geoff@gmail.com>
maintainer:    Geoffrey Noel <noel.geoff@gmail.com>
category:      Network
build-type:    Simple
extra-doc-files: CHANGELOG.md

source-repository head
  type:     git
  location: https://github.com/noel-geoff/otel-haskell

library
  hs-source-dirs: src
  default-language: GHC2021
  default-extensions:
    StrictData
    OverloadedStrings
    OverloadedRecordDot
    DuplicateRecordFields
    DerivingStrategies
    GADTs
    DataKinds
    KindSignatures
    TypeFamilies
  ghc-options: -Wall
  build-depends:
    base >= 4.18 && < 4.22,
    text >= 2.1 && < 2.2,
    bytestring >= 0.12 && < 0.13,
    containers >= 0.7 && < 0.8,
    vector >= 0.13 && < 0.14,
    stm >= 2.5 && < 2.6,
    async >= 2.2 && < 2.3,
    random >= 1.3 && < 1.4,
    otel-api >= 0.1 && < 0.2,
    otel-sdk-common >= 0.1 && < 0.2
  exposed-modules:
    OTel.SDK.Trace
    OTel.SDK.Trace.Sampler
    OTel.SDK.Trace.Processor
    OTel.SDK.Trace.Export
    OTel.SDK.Trace.IdGenerator

test-suite otel-sdk-traces-test
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  default-language: GHC2021
  default-extensions:
    StrictData
    OverloadedStrings
    OverloadedRecordDot
    DuplicateRecordFields
    DerivingStrategies
    GADTs
    DataKinds
    KindSignatures
    TypeFamilies
  ghc-options: -Wall -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    otel-sdk-traces,
    otel-api >= 0.1 && < 0.2,
    otel-sdk-common >= 0.1 && < 0.2,
    base >= 4.18 && < 4.22,
    tasty >= 1.5 && < 1.6,
    tasty-quickcheck >= 0.11 && < 0.12,
    tasty-hunit >= 0.10 && < 0.11,
    QuickCheck >= 2.18 && < 2.19,
    text >= 2.1 && < 2.2,
    stm >= 2.5 && < 2.6,
    vector >= 0.13 && < 0.14,
    bytestring >= 0.12 && < 0.13
