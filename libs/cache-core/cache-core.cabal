cabal-version:      3.0
name:               cache-core
version:            0.1.0.0
synopsis:           In-memory LRU cache with per-namespace policies and TTL
description:        Thread-safe in-memory cache with multiple namespaces,
                    configurable eviction strategies (LRU, LFU, FIFO, TTL),
                    and per-namespace statistics.
license:            MIT
author:             Geoffrey Noël
maintainer:         noel.geoff@gmail.com
category:           Data
build-type:         Simple

common shared-properties
    default-language: GHC2021
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints
        -Wunused-packages
    default-extensions:
        DerivingStrategies
        DuplicateRecordFields
        LambdaCase
        OverloadedRecordDot
        OverloadedStrings

library
    import:           shared-properties
    hs-source-dirs:   src
    exposed-modules:
        Cache.Core
    build-depends:
        base >=4.18 && <5,
        otel-api,
        bytestring >=0.11,
        containers >=0.6,
        stm >=2.5,
        text >=2.0,
        time >=1.12

test-suite cache-core-test
    import:           shared-properties
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    build-depends:
        base >=4.18 && <5,
        cache-core,
        bytestring >=0.11,
        hedgehog >=1.4,
        tasty >=1.4,
        tasty-hedgehog >=1.4
    ghc-options:
        -threaded
        -rtsopts
        -with-rtsopts=-N
